display "`c(username)'"

if "`c(username)'" == "dpvlv12" {
    global root "G:\Mi unidad\MIMP\Observatorio Nacional de Violencia\ENARES"
}
else if "`c(username)'" == "Alexandra Otero" {
    global root "H:\Mi unidad\MIMP\Observatorio Nacional de Violencia\ENARES"
}
else {
    di as error "Usuario no reconocido: `c(username)'. Ajusta ROOT."
    exit 198
}

di as txt "Directorio de trabajo:  $root"
*--- Rutas (ajusta si aplica) ---
global data_2024 "$root/Data/2024"
global csr01_2024 "$data_2024/CSR01"
global output     "$root/Outputs"

cap mkdir "$output"

*--- Helper: abrir, pasar a lower y armonizar nombres de ID ---
program define _open_norm
    syntax , File(string)
    capture confirm file "`file'"
    if _rc {
        di as error "No se encontró: `file'"
        exit 601
    }
    use "`file'", clear
    rename _all, lower

    * Armonizar posibles nombres alternativos -> persona_id y hogar_id
    capture confirm variable persona_id
    if _rc {
        foreach alt in idpersona id_persona per_id id_per nroper nro_per {
            capture confirm variable `alt'
            if !_rc {
                rename `alt' persona_id
                continue, break
            }
        }
    }
    capture confirm variable hogar_id
    if _rc {
        foreach alt in idhogar id_hogar hogar nrohogar nro_hogar {
            capture confirm variable `alt'
            if !_rc {
                rename `alt' hogar_id
                continue, break
            }
        }
    }
end

*--- Definir llaves (en lower) ---
local key_hogar  conglome ccdd ccpp ccdi nselv codccpp tohogar hogar_id
local key_pers   `key_hogar' persona_id

*===============================================================*
* 1) MASTER = CAP200 (PERSONAS)
*===============================================================*
_open_norm, file("$csr01_2024/02_CRS01_CAP200.dta")
tempfile cap200
save `cap200'

*===============================================================*
* 2) Módulos de PERSONA: 1:1 por `key_pers'
*===============================================================*
* CAP300
capture noisily {
    _open_norm, file("$csr01_2024/03_CRS01_CAP300.dta")
    tempfile cap300
    save `cap300'
}

* CAP402
capture noisily {
    _open_norm, file("$csr01_2024/05_CRS01_CAP402.dta")
    tempfile cap402
    save `cap402'
}

* CAP411 (si es a nivel persona; si fuera hogar, lo movemos abajo)
local cap411_level "persona"   // <-- CAMBIA a "hogar" si ese fuera el caso
capture noisily {
    _open_norm, file("$csr01_2024/07_CRS01_CAP411.dta")
    tempfile cap411
    save `cap411'
}

*===============================================================*
* 3) Bases de HOGAR: m:1 por `key_hogar'
*===============================================================*
* CAP100 (única a nivel de hogar)
_open_norm, file("$csr01_2024/01_CRS01_CAP100.dta")
tempfile cap100
save `cap100'

* CAP401 (si existe y es de hogar)
capture noisily {
    _open_norm, file("$csr01_2024/04_CRS01_CAP401.dta")
    tempfile cap401
    save `cap401'
}

*===============================================================*
* 4) MERGE SECUENCIAL
*===============================================================*
use `cap200', clear
di as txt "Master CAP200 (personas). N: " as res _N

* Validaciones de unicidad recomendadas (no detienen si fallan)
capture isid `key_pers'
if _rc di as error "Advertencia: CAP200 no es único por `key_pers' (revisar duplicados)."

*--- 4.1 CAP300 (1:1 persona)
capture confirm file `cap300'
if !_rc {
    preserve
        use `cap300', clear
        capture isid `key_pers'
        if _rc di as error "CAP300: llaves de persona no únicas."
    restore

    merge 1:1 `key_pers' using `cap300', keep(match) nogen
    di as txt "Tras CAP300 -> N: " as res _N
}

*--- 4.2 CAP402 (1:1 persona)
capture confirm file `cap402'
if !_rc {
    preserve
        use `cap402', clear
        capture isid `key_pers'
        if _rc di as error "CAP402: llaves de persona no únicas."
    restore

    merge 1:1 `key_pers' using `cap402', keep(match) nogen
    di as txt "Tras CAP402 -> N: " as res _N
}

*--- 4.3 CAP411 (según nivel)
capture confirm file `cap411'
if !_rc {
    if "`cap411_level'" == "persona" {
        preserve
            use `cap411', clear
            capture isid `key_pers'
            if _rc di as error "CAP411(persona): llaves de persona no únicas."
        restore

        merge 1:1 `key_pers' using `cap411', keep(match) nogen
        di as txt "Tras CAP411 (1:1 persona) -> N: " as res _N
    }
}

*--- 4.4 CAP100 (m:1 hogar)
preserve
    use `cap100', clear
    capture isid `key_hogar'
    if _rc di as error "CAP100: llaves de hogar no únicas (para m:1 usar using único)."
restore
merge m:1 `key_hogar' using `cap100', keep(match) nogen
di as txt "Tras CAP100 (m:1 hogar) -> N: " as res _N

*--- 4.5 CAP401 (m:1 hogar) si existe
capture confirm file `cap401'
if !_rc {
    preserve
        use `cap401', clear
        capture isid `key_hogar'
        if _rc di as error "CAP401: llaves de hogar no únicas."
    restore
    merge m:1 `key_hogar' using `cap401', keep(match) nogen
    di as txt "Tras CAP401 (m:1 hogar) -> N: " as res _N
}

compress
cap mkdir "$output"
save "$output/ENARES_2024_viol_economica.dta", replace
di as result "OK: $output/ENARES_2024_viol_economica.dta"

use "$output/ENARES_2024_viol_economica.dta", clear
e


* ----------------------------------------------------------
* Indicador: Violencia Económica
* ----------------------------------------------------------

* ----------------------------------------------------------
* 1. Variables de condición de unión
* ----------------------------------------------------------
gen mujer_unida      = inlist(c1p302, 1, 2)   // Casada o conviviente
gen mujer_exunida    = inlist(c1p302, 3, 4, 5) // Viuda, divorciada, separada/ex conviviente
gen soltera    = inlist(c1p302, 6) // Soltera

* ----------------------------------------------------------
* 2. Caso 1: Mujer actualmente unida + esposo/conviviente
* ----------------------------------------------------------
gen vio_eco1 = 0 if mujer_unida==1
foreach i in 1 2 3 4 5 6 {
    replace vio_eco1 = 1 if inlist(c1p403_`i', 1) & mujer_unida==1
}


* ----------------------------------------------------------
* 3. Caso 2: Mujer anteriormente unida
* ----------------------------------------------------------
gen vio_eco2 = 0 if mujer_exunida==1
foreach i in 1 2 3 4 5 6 {
    replace vio_eco2 = 1 if inlist(c1p420_`i', 1) & mujer_exunida==1
}

* ----------------------------------------------------------
* 4. Caso 3: Mujer soltera
* ----------------------------------------------------------

gen vio_eco3 = 0 if soltera==1
foreach i in 1 2 3  {
    replace vio_eco3 = 1 if inlist(c1p437_`i', 1) & soltera==1
}


* ----------------------------------------------------------
* 4. Numerador, denominador e indicador
* ----------------------------------------------------------
gen num = (vio_eco1==1 | vio_eco2==1 | vio_eco3==1 )
gen denom = (mujer_unida==1 | mujer_exunida==1 | soltera==1)

gen violencia_economica = .
replace violencia_economica = (num / denom)
label var violencia_economica "Indicador de violencia económica (%)"
tab  violencia_economica  [iw=factor_muj]


* ----------------------------------------------------------
* 5. Tabulados por estado civil de la mujer
* ----------------------------------------------------------

tab  vio_eco1 violencia_economica  [iw=factor_muj], nofreq row
tab  violencia_economica vio_eco2  [iw=factor_muj], nofreq row
tab  violencia_economica vio_eco3  [iw=factor_muj], nofreq row


recode area (2=0)
label define area 0 "Rural" 1 "Urbano"
label values area area

tab violencia_economica area  [iw=factor_muj], nofreq row

