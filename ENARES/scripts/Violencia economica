************************
**Programas sociales**
************************

* Definir la etiqueta de valores una sola vez
label define a 0 "No" 1 "Sí"

* Recode y asignar etiqueta a cada variable
foreach v of varlist c1p314_1 c1p314_2 c1p314_3 c1p314_4 c1p314_5 {
    recode `v' (2 = 0)
    label values `v' a
}


* Número de programas sociales a los que accede
egen programas_sociales = rowtotal(c1p314_1 c1p314_2 c1p314_3 c1p314_4 c1p314_5)

* Indicador: 1 si accede a uno o más, 0 si no accede a ninguno
gen acceso_programa = 1 if (programas_sociales >= 1)
replace acceso_programa = 0 if programas_sociales<1
label define acceso_programa 0 "No acceso a pp_ss" 1 "Sí acceso a más de un pp_ss"
label values acceso_programa acceso_programa


tab violencia_economica acceso_programa [iw=factor_muj], nofreq row




